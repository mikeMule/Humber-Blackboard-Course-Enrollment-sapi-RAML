#%RAML 1.0 DataType
type: object
properties:
  # courseRoleId:
  #   type: string
  #   description: Role of the user in the course (e.g., Student, Instructor)
  #   example: Student
  # availability:
  #   type: object
  #   properties:
  #     available:
  #       type: string
  #       description: Indicates if the user is available ("Yes" or "No")
  #       example: Yes
  dataSourceId?:
    type: string
    description: Source system ID
    example: DestinyOne
  userId?:
    type: string
    description: Unique ID for the user (from LMS)
    example: X0000023
  courseId?:
    type: string
    description: Unique ID for the course section
    example: T2018_002_28506
  startDate?:
    type: datetime-only
    description: Course start date
    example: 2018-01-01T00:00:00
  endDate?:
    type: datetime-only
    description: Course end date
    example: 2018-12-31T00:00:00
example: !include ../examples/StudentEnrollmentRequestExample.json